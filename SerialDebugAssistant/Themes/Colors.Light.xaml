<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="MainBgColor">#F7F9FC</Color><Color x:Key="ActivityBarBgColor">#E9EEF5</Color><Color x:Key="SidebarBgColor">#F1F5F9</Color><Color x:Key="TitleBarBgColor">#FFFFFF</Color><Color x:Key="BorderColor">#D7E0EA</Color>
    <Color x:Key="StatusBarConnectedColor">#2563EB</Color><Color x:Key="StatusBarDisconnectedColor">#FFFFFF</Color><Color x:Key="AccentColor">#2563EB</Color><Color x:Key="AccentHoverColor">#1D4ED8</Color><Color x:Key="SendButtonColor">#0F9D78</Color><Color x:Key="SendButtonHoverColor">#0B8465</Color>
    <Color x:Key="ForegroundColor">#182230</Color><Color x:Key="ForegroundInactiveColor">#64748B</Color><Color x:Key="RxTextColor">#087F5B</Color><Color x:Key="TxTextColor">#2563EB</Color><Color x:Key="TimestampColor">#718096</Color><Color x:Key="ErrorColor">#D14343</Color><Color x:Key="SuccessColor">#0F9D78</Color>
