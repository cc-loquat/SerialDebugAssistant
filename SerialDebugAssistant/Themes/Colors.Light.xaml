    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="{StaticResource ChartBackgroundColor}"/><SolidColorBrush x:Key="ChartBorderBrush" Color="{StaticResource ChartBorderColor}"/><SolidColorBrush x:Key="ChartGridBrush" Color="{StaticResource ChartGridColor}"/><SolidColorBrush x:Key="ChartTextBrush" Color="{StaticResource ChartTextColor}"/><SolidColorBrush x:Key="ChartTargetBrush" Color="{StaticResource ChartTargetColor}"/><SolidColorBrush x:Key="ChartActualBrush" Color="{StaticResource ChartActualColor}"/>
