<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- VSCode Dark Modern 配色 -->
    <Color x:Key="MainBgColor">#1F1F1F</Color>
    <Color x:Key="ActivityBarBgColor">#181818</Color>
    <Color x:Key="SidebarBgColor">#181818</Color>
    <Color x:Key="TitleBarBgColor">#181818</Color>
    <Color x:Key="BorderColor">#2B2B2B</Color>

    <!-- 状态栏：正常态黑色，仅调试/连接时蓝色 -->
    <Color x:Key="StatusBarConnectedColor">#0078D4</Color>
    <Color x:Key="StatusBarDisconnectedColor">#181818</Color>

    <!-- 蓝色 accent 调低饱和度，更柔和的青色蓝 -->
    <Color x:Key="AccentColor">#3C88B5</Color>
    <Color x:Key="AccentHoverColor">#2C6E99</Color>
    <Color x:Key="SendButtonColor">#19A974</Color>
    <Color x:Key="SendButtonHoverColor">#28C58B</Color>

    <Color x:Key="ForegroundColor">#CCCCCC</Color>
    <Color x:Key="ForegroundInactiveColor">#868686</Color>
    <Color x:Key="RxTextColor">#4EC9B0</Color>
    <Color x:Key="TxTextColor">#569CD6</Color>
    <Color x:Key="TimestampColor">#808080</Color>
    <Color x:Key="ErrorColor">#F85149</Color>
    <Color x:Key="SuccessColor">#2EA043</Color>

    <!-- 输入控件背景 -->
    <Color x:Key="InputBgColor">#313131</Color>
    <Color x:Key="InputBorderNormalColor">#3C3C3C</Color>

    <SolidColorBrush x:Key="MainBgBrush" Color="{StaticResource MainBgColor}"/>
    <SolidColorBrush x:Key="ActivityBarBgBrush" Color="{StaticResource ActivityBarBgColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="TitleBarBgBrush" Color="{StaticResource TitleBarBgColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="StatusBarConnectedBrush" Color="{StaticResource StatusBarConnectedColor}"/>
    <SolidColorBrush x:Key="StatusBarDisconnectedBrush" Color="{StaticResource StatusBarDisconnectedColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="SendButtonBrush" Color="{StaticResource SendButtonColor}"/>
    <SolidColorBrush x:Key="SendButtonHoverBrush" Color="{StaticResource SendButtonHoverColor}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="ForegroundInactiveBrush" Color="{StaticResource ForegroundInactiveColor}"/>
    <SolidColorBrush x:Key="RxTextBrush" Color="{StaticResource RxTextColor}"/>
    <SolidColorBrush x:Key="TxTextBrush" Color="{StaticResource TxTextColor}"/>
    <SolidColorBrush x:Key="TimestampBrush" Color="{StaticResource TimestampColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputBorderNormalBrush" Color="{StaticResource InputBorderNormalColor}"/>

    <!-- 滚动条颜色 -->
    <Color x:Key="ScrollbarThumbColor">#424242</Color>
    <Color x:Key="ScrollbarThumbHoverColor">#555555</Color>
    <Color x:Key="ScrollbarTrackColor">#001E1E1E</Color>

    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource ScrollbarThumbColor}"/>
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{StaticResource ScrollbarThumbHoverColor}"/>
    <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="{StaticResource ScrollbarTrackColor}"/>

    <!-- 下拉菜单颜色 -->
    <Color x:Key="DropdownBgColor">#252526</Color>
    <Color x:Key="DropdownBorderColor">#3C3C3C</Color>
    <Color x:Key="DropdownHoverColor">#2A2D2E</Color>
    <Color x:Key="DropdownSelectedColor">#094771</Color>

    <SolidColorBrush x:Key="DropdownBgBrush" Color="{StaticResource DropdownBgColor}"/>
    <SolidColorBrush x:Key="DropdownBorderBrush" Color="{StaticResource DropdownBorderColor}"/>
    <SolidColorBrush x:Key="DropdownHoverBrush" Color="{StaticResource DropdownHoverColor}"/>
    <SolidColorBrush x:Key="DropdownSelectedBrush" Color="{StaticResource DropdownSelectedColor}"/>

    <!-- 文本选择颜色 -->
    <Color x:Key="SelectionColor">#264F78</Color>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>

    <!-- 活动栏图标颜色 -->
    <Color x:Key="ActivityIconColor">#868686</Color>
    <SolidColorBrush x:Key="ActivityIconBrush" Color="{StaticResource ActivityIconColor}"/>
    <Color x:Key="ChartBackgroundColor">#15181C</Color>
    <Color x:Key="ChartBorderColor">#29313A</Color>
    <Color x:Key="ChartGridColor">#2D353E</Color>
    <Color x:Key="ChartTextColor">#8B95A3</Color>
    <Color x:Key="ChartTargetColor">#E5A84B</Color>
    <Color x:Key="ChartActualColor">#4CC9A4</Color>
    <FontFamily x:Key="ThemeFontFamily">Microsoft YaHei UI, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="{StaticResource ChartBackgroundColor}"/>
    <SolidColorBrush x:Key="ChartBorderBrush" Color="{StaticResource ChartBorderColor}"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="{StaticResource ChartGridColor}"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="{StaticResource ChartTextColor}"/>
    <SolidColorBrush x:Key="ChartTargetBrush" Color="{StaticResource ChartTargetColor}"/>
    <SolidColorBrush x:Key="ChartActualBrush" Color="{StaticResource ChartActualColor}"/>
</ResourceDictionary>
