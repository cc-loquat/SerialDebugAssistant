<UserControl x:Class="SerialDebugAssistant.Views.Controls.ActivityBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ActivityBarBgBrush}">

    <StackPanel Orientation="Vertical" VerticalAlignment="Top">
        <Button Style="{DynamicResource ActivityIconButton}" Content="≡" ToolTip="串口参数" FontSize="20"/>
        <Button Style="{DynamicResource ActivityIconButton}" Content="⋞" ToolTip="日志" FontSize="18"/>
        <Button Style="{DynamicResource ActivityIconButton}" Content="⚙" ToolTip="设置" FontSize="20"/>
        <Button Style="{DynamicResource ActivityIconButton}" Content="i" ToolTip="关于" FontSize="18" FontWeight="Bold"/>
    </StackPanel>
</UserControl>
