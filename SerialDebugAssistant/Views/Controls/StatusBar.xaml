<UserControl x:Class="SerialDebugAssistant.Views.Controls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26">
    <Grid Background="{DynamicResource TitleBarBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 状态指示灯：连接绿，断开灰 -->
        <Ellipse Grid.Column="0" Width="10" Height="10" Margin="12,0,0,0"
                 VerticalAlignment="Center">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource ForegroundInactiveBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>

        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource ForegroundBrush}"
                   VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 更新提示按钮（当 UpdateAvailable 时显示） -->
        <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                Command="{Binding ApplyUpdateCommand}"
                FontSize="12" Cursor="Hand"
                Foreground="{DynamicResource RxTextBrush}" Background="Transparent" BorderThickness="0"
                ToolTip="点击下载并安装更新">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⬆ " FontSize="12" Foreground="{DynamicResource RxTextBrush}" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource RxTextBrush}" VerticalAlignment="Center">
                    <Run Text="发现新版本: "/>
                    <Run Text="{Binding UpdateVersion}" FontWeight="Bold"/>
                    <Run Text="  — 点击更新"/>
                </TextBlock>
            </StackPanel>
        </Button>

        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="12">
            <Run Text="{Binding SelectedPort}"/>
        </TextBlock>

        <Border Grid.Column="3" Width="1" Height="16"
                Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>

        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="12,0,12,0"
                   Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="12">
            <Run Foreground="{DynamicResource RxTextBrush}" Text="RX"/>
            <Run Text=":"/>
            <Run Text="{Binding RxByteCount}"/>
            <Run Text="  "/>
            <Run Foreground="{DynamicResource TxTextBrush}" Text="TX"/>
            <Run Text=":"/>
            <Run Text="{Binding TxByteCount}"/>
        </TextBlock>
    </Grid>
</UserControl>
