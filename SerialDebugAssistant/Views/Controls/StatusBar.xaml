<UserControl x:Class="SerialDebugAssistant.Views.Controls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26">
    <Grid Background="{DynamicResource TitleBarBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 状态指示灯：连接绿，断开灰 -->
        <Ellipse Grid.Column="0" Width="10" Height="10" Margin="12,0,0,0"
                 VerticalAlignment="Center">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#6E7681"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                            <Setter Property="Fill" Value="#2EA043"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>

        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource ForegroundBrush}"
                   VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>

        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="12">
            <Run Text="{Binding SelectedPort}"/>
        </TextBlock>

        <Border Grid.Column="3" Width="1" Height="16"
                Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>

        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="12,0,12,0"
                   Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="12">
            <Run Foreground="{DynamicResource RxTextBrush}" Text="RX"/>
            <Run Text=":"/>
            <Run Text="{Binding RxByteCount}"/>
            <Run Text="  "/>
            <Run Foreground="{DynamicResource TxTextBrush}" Text="TX"/>
            <Run Text=":"/>
            <Run Text="{Binding TxByteCount}"/>
        </TextBlock>
    </Grid>
</UserControl>
