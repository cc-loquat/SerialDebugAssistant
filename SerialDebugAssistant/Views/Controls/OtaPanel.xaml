<UserControl x:Class="SerialDebugAssistant.Views.Controls.OtaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource MainBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
    <Grid Margin="18,14,18,10" MinHeight="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="0.92*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
            <TextBlock Text="OTA 升级" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock Text="通过串口将 .bin 固件写入设备。升级会擦除当前 App。" Margin="0,5,0,0" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="1. 准备设备" Style="{DynamicResource SectionHeaderStyle}"/>
                    <TextBlock Text="{Binding ConnectionStatus}" Margin="0,10,0,0" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="OTA 页面不会发送进入升级或擦除指令。" Margin="0,6,0,0" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="11" TextWrapping="Wrap"/>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20,0,18"/>
                <TextBlock Text="2. 选择固件" Style="{DynamicResource SectionHeaderStyle}"/>
                <TextBlock Text="传输协议" Style="{DynamicResource LabelStyle}" Margin="0,8,0,2"/>
                <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding SelectedProtocol}" Height="30" Style="{DynamicResource ParameterComboBoxStyle}"/>
                <Button Content="选择 .bin 文件" Height="34" Margin="0,10,0,10" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ChooseFirmwareCommand}"/>
                <TextBlock Text="{Binding FirmwareName}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding FirmwareSize}" Margin="0,5,0,0" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="11"/>
                <TextBlock Text="{Binding FirmwareCrc32}" Margin="0,3,0,0" Foreground="{DynamicResource ForegroundInactiveBrush}" FontFamily="Cascadia Code, Consolas" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="3. 发送固件" Style="{DynamicResource SectionHeaderStyle}"/>
                    <TextBlock Text="确认设备已进入你的升级模式后，再发送固件。" Margin="0,6,0,10" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <Button Content="发送固件" Height="38" Style="{DynamicResource SendButtonStyle}" Command="{Binding StartUpgradeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="升级状态" Style="{DynamicResource SectionHeaderStyle}"/>
                    <TextBlock Text="{Binding StageText}" Margin="0,14,0,4" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="9" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InputBgBrush}"/>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TransferDetail}" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="升级期间请勿断开设备或关闭软件。" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="11" Margin="0,0,0,10"/>
                    <Button Content="停止升级" Height="34" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding StopUpgradeCommand}"/>
                </StackPanel>
                <Border Grid.Row="3" Margin="0,16,0,0" Padding="10,8" Background="{DynamicResource MainBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="协议提醒" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="10" TextWrapping="Wrap">
                            <Run Text="这不是通用标准，设备 Bootloader 必须按本格式接收："/><LineBreak/>
                            <Run Text="FWUP：46 57 55 50 + 长度/CRC32（小端）+ bin；YModem：C 握手 + 1K 分包 + CRC16。" FontFamily="Cascadia Code, Consolas"/><LineBreak/>
                            <Run Text="请选择与设备 Bootloader 完全一致的协议，FWUP 不带换行。"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid Margin="16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="升级日志" Style="{DynamicResource SectionHeaderStyle}"/><Button Content="清空" HorizontalAlignment="Right" Height="24" Width="52" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ClearLogsCommand}"/></Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding UpgradeLogs}" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ForegroundInactiveBrush}" FontFamily="Cascadia Code, Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
