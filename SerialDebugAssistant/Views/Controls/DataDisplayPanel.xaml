<UserControl x:Class="SerialDebugAssistant.Views.Controls.DataDisplayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource MainBgBrush}">
    <Grid Background="{DynamicResource MainBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="接收区" Style="{DynamicResource PanelGroupBoxStyle}">
            <Grid Margin="4,4,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <RadioButton Content="ASCII" Style="{DynamicResource OptionRadioStyle}"
                                 IsChecked="{Binding ReceiveAsAscii, Mode=TwoWay}"/>
                    <RadioButton Content="HEX" Style="{DynamicResource OptionRadioStyle}"
                                 IsChecked="{Binding ReceiveAsHex, Mode=TwoWay}"/>
                </StackPanel>
                <RichTextBox Grid.Row="1" x:Name="RecvBox"
                             IsReadOnly="True"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             FontSize="13"
                             Background="{DynamicResource MainBgBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderThickness="0"
                             Padding="8,4"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto">
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type DocumentPageView}"/>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Grid>
        </GroupBox>

        <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <GroupBox Grid.Row="2" Header="发送区" Style="{DynamicResource PanelGroupBoxStyle}">
            <Grid Margin="4,4,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <RadioButton Content="ASCII" Style="{DynamicResource OptionRadioStyle}"
                                 IsChecked="{Binding SendAsAscii, Mode=TwoWay}"/>
                    <RadioButton Content="HEX" Style="{DynamicResource OptionRadioStyle}"
                                 IsChecked="{Binding SendAsHex, Mode=TwoWay}"/>
                </StackPanel>
                <TextBox Grid.Row="1" x:Name="SendBox"
                         Style="{DynamicResource DataTextBoxStyle}"
                         Text="{Binding SendText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         PreviewKeyDown="SendBox_PreviewKeyDown"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,4,4">
                    <Button Content="发送" Width="80" Height="30"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Command="{Binding SendCommand}"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
