<UserControl x:Class="SerialDebugAssistant.Views.Controls.PidPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource MainBgBrush}">
    <Grid Background="{DynamicResource MainBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- 曲线控制栏 -->
        <Grid Grid.Row="0" Margin="12,8,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="通道:" Style="{DynamicResource LabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="目标值" IsChecked="{Binding ShowTargetLine}" Style="{DynamicResource CheckBoxStyle}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="2" Content="实际值" IsChecked="{Binding ShowActualLine}" Style="{DynamicResource CheckBoxStyle}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Rectangle Width="10" Height="3" Fill="{DynamicResource ChartTargetBrush}" RadiusX="1" RadiusY="1" Margin="0,0,4,0"/>
                <TextBlock Text="目标" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="11" Margin="0,0,12,0"/>
                <Rectangle Width="10" Height="3" Fill="{DynamicResource ChartActualBrush}" RadiusX="1" RadiusY="1" Margin="0,0,4,0"/>
                <TextBlock Text="实际" Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,8,0">
                <Button Content="{Binding PauseButtonText}" Width="60" Height="26" Margin="0,0,6,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding TogglePauseCommand}"/>
                <Button Content="清除" Width="50" Height="26"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Command="{Binding ClearDataCommand}"/>
            </StackPanel>
            <Button Grid.Column="5" Content="导出CSV" Width="70" Height="26"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Command="{Binding ExportCsvCommand}"/>
        </Grid>

        <!-- 曲线图区域 -->
        <Border Grid.Row="1" Margin="12,4,12,4" Background="{DynamicResource ChartBackgroundBrush}" BorderBrush="{DynamicResource ChartBorderBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <Grid>
                <Canvas x:Name="ChartCanvas" Background="Transparent"
                        SizeChanged="ChartCanvas_SizeChanged"
                        MouseWheel="ChartCanvas_MouseWheel"
                        MouseDown="ChartCanvas_MouseDown"
                        MouseMove="ChartCanvas_MouseMove"
                        MouseUp="ChartCanvas_MouseUp"/>
                <!-- Y轴标签 -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4">
                    <TextBlock Text="{Binding YAxisMaxText}" Foreground="{DynamicResource ChartTextBrush}" FontSize="10" FontFamily="Cascadia Code"/>
                    <TextBlock Text="{Binding YAxisMidText}" Foreground="{DynamicResource ChartTextBrush}" FontSize="10" FontFamily="Cascadia Code" Margin="0,80,0,0"/>
                    <TextBlock Text="{Binding YAxisMinText}" Foreground="{DynamicResource ChartTextBrush}" FontSize="10" FontFamily="Cascadia Code" Margin="0,80,0,0"/>
                </StackPanel>
                <!-- 提示信息 -->
                <TextBlock Text="等待数据..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundInactiveBrush}" FontSize="13"
                           Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}"/>
            </Grid>
        </Border>

        <!-- 分割线 -->
        <GridSplitter Grid.Row="2" Height="3" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- 原始数据区 -->
        <GroupBox Grid.Row="3" Header="原始数据" Style="{DynamicResource PanelGroupBoxStyle}">
            <Grid Margin="4,4,4,0">
                <RichTextBox x:Name="PidDataBox"
                             IsReadOnly="True"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             FontSize="12"
                             Background="{DynamicResource MainBgBrush}"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderThickness="0"
                             Padding="8,4"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto">
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type DocumentPageView}"/>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
